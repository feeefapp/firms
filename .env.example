# Copy to .env (never commit it). Variables already set in the environment win.
# Only FIRMS_PUBLIC_ORIGIN is needed to browse the seed data; the rest unlocks features.

# --- server
FIRMS_BIND=127.0.0.1:8787
FIRMS_PUBLIC_ORIGIN=http://localhost:8787
FIRMS_DATA_DIR=/tmp/firms-data
FIRMS_SEED_DIR=../data
FIRMS_TOOLS_DIR=../tools
FIRMS_WEB_DIR=../web/dist
FIRMS_PYTHON=python3
FIRMS_LOG=info
# 64 hex chars (openssl rand -hex 32); generated into the data dir when empty
FIRMS_SESSION_KEY=
# extra origins accepted by the CSRF check (the Vite dev server)
FIRMS_EXTRA_ORIGINS=http://localhost:5190
# browser origins allowed to call /mcp besides the known AI clients
FIRMS_MCP_ORIGINS=
# load another env file instead of ../.env
FIRMS_ENV_FILE=

# --- NASA FIRMS (https://firms.modaps.eosdis.nasa.gov/api/map_key/): live hotspots, globe days, ranges, region builds
FIRMS_MAP_KEY=

# --- Sign in with feeef (OAuth 2 + PKCE, confidential client) and feeef Cloud AI for the agent
FIRMS_FEEEF_API_URL=https://api.beta.feeef.org/v1
FIRMS_FEEEF_ACCOUNTS_URL=https://accounts.beta.feeef.org
FIRMS_FEEEF_CLIENT_ID=
FIRMS_FEEEF_CLIENT_SECRET=
FIRMS_FEEEF_REDIRECT_URI=http://localhost:8787/auth/feeef/callback
# FIRMS_AI_DISABLED=1
# FIRMS_AI_MODEL=

# --- web dev server (web/vite.config.ts)
# FIRMS_API=http://localhost:8787   # where /api, /auth, /oauth, /mcp are proxied
# FIRMS_MOCK=1                      # serve the seed data from Vite, no Rust server needed
